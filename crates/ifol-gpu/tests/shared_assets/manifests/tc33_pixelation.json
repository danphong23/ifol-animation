{
  "test_case": "TC33",
  "title": "Pixelation / Mosaic Filter",
  "title_vi": "Bộ lọc khảm điểm ảnh",
  "description": "Extract a canonical paladin sprite and snap its UV sampling to 16-pixel blocks.",
  "description_vi": "Tách nhân vật paladin canonical rồi lấy mẫu UV theo các ô vuông 16 pixel.",
  "input_policy_vi": "Desktop và WebGPU dùng sprite sheet PNG canonical; không dùng decoder JPEG trong phép đo parity.",
  "graph": {
    "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
    "targets": [
      { "id": "chroma", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
      { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }
    ],
    "sampler": { "address_mode_u": "repeat", "address_mode_v": "repeat", "address_mode_w": "repeat", "mag_filter": "linear", "min_filter": "linear", "mipmap_filter": "linear" },
    "pipelines": {
      "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" },
      "pixelation": { "shader": "pixelation.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" }
    },
    "operations": [
      {
        "id": "chroma_extract_paladin",
        "kind": "chroma_key",
        "pass": "chroma_pass",
        "pipeline": "chroma",
        "shader": "chroma_key_cropped.wgsl",
        "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }],
        "uniform": { "scale_y": 0.8, "uv_min": [0.005, 0.01], "uv_max": [0.28, 0.98], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.48, "smoothness": 0.1 },
        "vertex_count": 6,
        "instance_count": 1
      },
      {
        "id": "pixelate_16px",
        "kind": "pixelation",
        "pass": "pixelation_pass",
        "pipeline": "pixelation",
        "shader": "pixelation.wgsl",
        "source": [{ "kind": "target", "target": "chroma" }],
        "uniform": { "block_size": 16.0, "screen_width": 800.0, "screen_height": 600.0 },
        "vertex_count": 6,
        "instance_count": 1
      }
    ],
    "passes": [
      { "id": "chroma_pass", "name": "Chroma key extraction", "target": "chroma", "clear_color": [0.0, 0.0, 0.0, 0.0] },
      { "id": "pixelation_pass", "name": "16px mosaic filter", "target": "final", "clear_color": [0.1, 0.1, 0.3, 1.0] }
    ],
    "command_count": 2,
    "node_count": 2
  },
  "evaluation": {
    "expected_non_empty": true,
    "expected_layer_order": ["chroma_pass", "pixelation_pass"],
    "expected_instance_count": 2,
    "visual_check": "Nền xanh đậm có nhân vật paladin với các ô mosaic 16px rõ ràng, alpha và hình dáng vẫn nhận diện được; không có ảnh đen hoặc validation error."
  }
}
