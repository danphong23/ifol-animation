{
  "test_case": "TC30",
  "title": "Dissolve / Burn Transition",
  "title_vi": "Chuyển cảnh tan biến và cháy viền",
  "description": "Extract a canonical sprite with chroma key, then dissolve it with a deterministic noise map and glowing edge.",
  "description_vi": "Tách nhân vật bằng chroma key, sau đó làm tan biến theo noise map với viền cháy phát sáng.",
  "input_policy_vi": "Desktop và WebGPU dùng hai fixture PNG canonical: sprite sheet và noise map; không dùng decoder JPEG trong phép đo parity.",
  "graph": {
    "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
    "targets": [
      { "id": "chroma", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
      { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }
    ],
    "sampler": {
      "address_mode_u": "clamp-to-edge",
      "address_mode_v": "clamp-to-edge",
      "address_mode_w": "clamp-to-edge",
      "mag_filter": "linear",
      "min_filter": "linear",
      "mipmap_filter": "linear"
    },
    "pipelines": {
      "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" },
      "dissolve": { "shader": "dissolve.wgsl", "blend": "AlphaBlending", "layout": "dual_texture_uniform" }
    },
    "operations": [
      {
        "id": "chroma_extract",
        "kind": "chroma_key",
        "pass": "chroma_pass",
        "pipeline": "chroma",
        "shader": "chroma_key_cropped.wgsl",
        "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }],
        "asset": "canonical_sprites_heroes.png",
        "uniform": {
          "scale_y": 0.8,
          "uv_min": [0.005, 0.01],
          "uv_max": [0.28, 0.98],
          "key_color": [0.0, 1.0, 0.0],
          "tolerance": 0.48,
          "smoothness": 0.1
        },
        "vertex_count": 6,
        "instance_count": 1
      },
      {
        "id": "dissolve_burn",
        "kind": "dissolve_burn",
        "pass": "dissolve_pass",
        "pipeline": "dissolve",
        "shader": "dissolve.wgsl",
        "source": [
          { "kind": "target", "target": "chroma" },
          { "kind": "asset", "asset": "canonical_tc085_noise.png" }
        ],
        "uniform": {
          "threshold": 0.5,
          "edge_width": 0.05,
          "edge_color": [1.0, 0.4, 0.1]
