        "vertex_count": 6,
        "instance_count": 1
      }
    ],
    "passes": [
      { "id": "chroma_pass", "name": "Chroma key extraction", "target": "chroma", "clear_color": [0.0, 0.0, 0.0, 0.0] },
      { "id": "dissolve_pass", "name": "Dissolve and glowing edge", "target": "final", "clear_color": [0.2, 0.2, 0.2, 1.0] }
    ],
    "command_count": 2,
    "node_count": 2
  },
  "evaluation": {
    "expected_non_empty": true,
    "expected_layer_order": ["chroma_pass", "dissolve_pass"],
    "expected_instance_count": 2,
    "visual_check": "Nền xám có nhân vật đã tách nền xanh, một phần nhân vật tan biến theo noise và có viền cam cháy; không có ảnh đen, texture mất hoặc validation error."
  }
}
