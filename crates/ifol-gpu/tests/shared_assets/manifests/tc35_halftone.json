{
  "test_case": "TC35",
  "title": "Halftone / Comic Print Filter",
  "title_vi": "Bộ lọc in lưới điểm",
  "description": "Extract a canonical paladin sprite and render it as rotated 45-degree halftone dots based on luminance.",
  "description_vi": "Tách nhân vật paladin canonical rồi chuyển thành các chấm halftone xoay 45 độ theo độ sáng.",
  "input_policy_vi": "Desktop và WebGPU dùng sprite sheet PNG canonical; không dùng decoder JPEG trong phép đo parity.",
  "graph": {
    "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
    "targets": [
      { "id": "chroma", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
      { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }
    ],
    "sampler": { "address_mode_u": "repeat", "address_mode_v": "repeat", "address_mode_w": "repeat", "mag_filter": "linear", "min_filter": "linear", "mipmap_filter": "linear" },
    "pipelines": {
      "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" },
      "halftone": { "shader": "halftone.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" }
    },
    "operations": [
      {
        "id": "chroma_extract_paladin",
        "kind": "chroma_key",
        "pass": "chroma_pass",
        "pipeline": "chroma",
        "shader": "chroma_key_cropped.wgsl",
        "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }],
        "uniform": { "scale_y": 0.8, "uv_min": [0.005, 0.01], "uv_max": [0.28, 0.98], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.48, "smoothness": 0.1 },
        "vertex_count": 6,
        "instance_count": 1
      },
      {
        "id": "halftone_45deg",
        "kind": "halftone",
        "pass": "halftone_pass",
        "pipeline": "halftone",
        "shader": "halftone.wgsl",
        "source": [{ "kind": "target", "target": "chroma" }],
        "uniform": { "dot_size": 8.0, "angle": 0.7853981633974483, "smoothness": 0.05, "screen_width": 800.0, "screen_height": 600.0 },
        "vertex_count": 6,
        "instance_count": 1
      }
    ],
    "passes": [
      { "id": "chroma_pass", "name": "Chroma key extraction", "target": "chroma", "clear_color": [0.0, 0.0, 0.0, 0.0] },
      { "id": "halftone_pass", "name": "45 degree halftone", "target": "final", "clear_color": [0.9, 0.8, 0.2, 1.0] }
    ],
    "command_count": 2,
    "node_count": 2
  },
  "evaluation": {
    "expected_non_empty": true,
    "expected_layer_order": ["chroma_pass", "halftone_pass"],
    "expected_instance_count": 2,
    "visual_check": "Nền vàng comic có nhân vật paladin được tạo từ các chấm đen/trắng theo lưới xoay 45 độ, alpha được giữ và không có ảnh đen hoặc validation error."
  }
}
