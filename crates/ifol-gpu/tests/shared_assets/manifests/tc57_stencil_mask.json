    "operations": [
      { "id": "stencil_mask_circle", "kind": "stencil_write", "pass": "portal_pass", "pipeline": "mask", "shader": "stencil_mask.wgsl", "source": [{ "kind": "asset", "asset": "canonical_bg_nightsky.png" }], "uniform": { "radius": 0.38, "aspect": 1.3333333 }, "vertex_count": 6, "instance_count": 1 },
      { "id": "stencil_nightsky", "kind": "masked_background", "pass": "portal_pass", "pipeline": "content", "shader": "chroma_key_cropped.wgsl", "source": [{ "kind": "asset", "asset": "canonical_bg_nightsky.png" }], "uniform": { "opacity": 1.0 }, "vertex_count": 6, "instance_count": 1 },
      { "id": "stencil_wizard", "kind": "masked_sprite", "pass": "portal_pass", "pipeline": "content", "shader": "chroma_key_cropped.wgsl", "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }], "uniform": { "scale_y": 0.65, "uv_min": [0.30, 0.0], "uv_max": [0.52, 1.0] }, "vertex_count": 6, "instance_count": 1 }
    ],
    "passes": [{ "id": "portal_pass", "name": "Stencil portal", "target": "final", "clear_color": [0.05, 0.05, 0.08, 1.0] }],
    "command_count": 3,
    "node_count": 2
  },
  "evaluation": { "expected_non_empty": true, "expected_layer_order": ["portal_pass"], "expected_instance_count": 3, "visual_check": "Portal tròn sắc nét ở tâm; cảnh và wizard chỉ xuất hiện trong mask, ngoài mask giữ màu nền." }
}
