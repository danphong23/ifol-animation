{
  "test_case": "TC09",
  "title": "Pipeline Caching and Bundle Reuse",
  "title_vi": "Pipeline caching và tái sử dụng render bundle",
  "description": "Execute the same graph once cold and ten warm times while reusing the registered pipelines, resources and graph.",
  "description_vi": "Chạy cùng một graph một lần cold và mười lần warm, tái sử dụng pipeline, resource và graph để đo cache/bundle.",
  "graph": {
    "target": {
      "kind": "offscreen",
      "width": 800,
      "height": 600,
      "format": "Rgba8UnormSrgb"
    },
    "sampler": {
      "address_mode_u": "repeat",
      "address_mode_v": "repeat",
      "address_mode_w": "repeat",
      "mag_filter": "nearest",
      "min_filter": "nearest",
      "mipmap_filter": "nearest"
    },
    "pipelines": {
      "background": {
        "shader": "texture_blit.wgsl",
        "blend": "Replace",
        "depth": false,
        "has_uniform": false
      },
      "particles": {
        "shader": "particles_10k.wgsl",
        "blend": "AlphaBlend",
        "depth": false,
        "has_uniform": false
      }
    },
    "operations": [
      {
        "id": "background",
        "kind": "texture",
        "pipeline": "background",
        "source": { "kind": "asset", "asset": "canonical_bg_nightsky.png" },
        "vertex_count": 6,
        "instance_count": 1
      },
      {
        "id": "particles",
        "kind": "procedural_particles",
        "pipeline": "particles",
        "vertex_count": 6,
        "instance_count": 10000
      }
    ],
    "command_count": 2,
    "node_count": 1,
    "clear_color": [0.02, 0.02, 0.05, 1.0]
  },
  "cache_contract": {
    "warm_iteration_count": 10,
    "reuse_graph": true,
    "reuse_pipelines": true,
    "reuse_resources": true,
    "rebuild_between_iterations": false
  },
  "evaluation": {
    "expected_non_empty": true,
    "expected_particle_instances": 10000,
    "expected_same_output_after_cache": true,
    "visual_check": "Nền trời đêm phủ toàn target và có nhiều hạt bụi sao procedural; output sau các lần warm phải giữ nguyên, không crash, không xuất hiện artifact hoặc mất draw command. Timing warm được báo cáo để đánh giá cache, không áp đặt ngưỡng phần cứng cố định."
  }
}
