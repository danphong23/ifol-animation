{
  "test_case": "TC42",
  "title": "Full-Frame HDR Bloom",
  "title_vi": "Bloom HDR toàn khung",
  "description": "Extract a mage, isolate emissive highlights, and composite bloom over a canonical sci-fi background.",
  "description_vi": "Tách mage, lấy vùng phát sáng, rồi cộng bloom lên nền Sci-Fi canonical trong composite nhiều pass.",
  "input_policy_vi": "Desktop và WebGPU dùng hai PNG canonical: canonical_sprites_heroes.png và canonical_bg_scifi.png.",
  "graph": {
    "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
    "targets": [{ "id": "mage", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }, { "id": "bloom", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }, { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }],
    "sampler": { "address_mode_u": "repeat", "address_mode_v": "repeat", "address_mode_w": "repeat", "mag_filter": "linear", "min_filter": "linear", "mipmap_filter": "linear" },
    "pipelines": { "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending" }, "bloom": { "shader": "emissive_bloom.wgsl", "blend": "AlphaBlending" }, "over": { "shader": "texture_blit.wgsl", "blend": "AlphaBlending" }, "add": { "shader": "texture_blit.wgsl", "blend": "Additive" } },
    "operations": [
      { "id": "chroma_extract_mage", "kind": "chroma_key", "pass": "chroma_pass", "pipeline": "chroma", "shader": "chroma_key_cropped.wgsl", "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }], "uniform": { "scale_y": 0.8, "uv_min": [0.27, 0.01], "uv_max": [0.54, 0.98], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.48, "smoothness": 0.1 }, "vertex_count": 6, "instance_count": 1 },
      { "id": "emissive_extract", "kind": "bloom_extract", "pass": "bloom_pass", "pipeline": "bloom", "shader": "emissive_bloom.wgsl", "source": [{ "kind": "target", "target": "mage" }], "uniform": { "threshold": 0.2, "intensity": 2.0, "blur_radius": 5.0 }, "vertex_count": 6, "instance_count": 1 },
      { "id": "background", "kind": "texture_blit", "pass": "final_pass", "pipeline": "over", "shader": "texture_blit.wgsl", "source": [{ "kind": "asset", "asset": "canonical_bg_scifi.png" }], "instance_count": 1 },
      { "id": "bloom_add", "kind": "texture_blit", "pass": "final_pass", "pipeline": "add", "shader": "texture_blit.wgsl", "source": [{ "kind": "target", "target": "bloom" }], "instance_count": 1 },
      { "id": "mage_over", "kind": "texture_blit", "pass": "final_pass", "pipeline": "over", "shader": "texture_blit.wgsl", "source": [{ "kind": "target", "target": "mage" }], "instance_count": 1 }
    ],
    "passes": [{ "id": "chroma_pass", "target": "mage", "clear_color": [0.0, 0.0, 0.0, 0.0] }, { "id": "bloom_pass", "target": "bloom", "clear_color": [0.0, 0.0, 0.0, 0.0] }, { "id": "final_pass", "target": "final", "clear_color": [0.05, 0.05, 0.1, 1.0] }],
    "command_count": 5,
    "node_count": 3
  },
  "evaluation": { "expected_non_empty": true, "expected_layer_order": ["chroma_pass", "bloom_pass", "final_pass"], "expected_instance_count": 5, "visual_check": "Nền Sci-Fi có mage và vùng phát sáng lan rộng, không bị cắt vuông; không có ảnh đen hoặc validation error." }
}
