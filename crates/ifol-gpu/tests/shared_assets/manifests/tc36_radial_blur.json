{
  "test_case": "TC36",
  "title": "Radial Blur / Zoom Blur",
  "title_vi": "Làm nhòe tỏa tâm",
  "description": "Extract a canonical paladin sprite and apply a 30-sample radial zoom blur.",
  "description_vi": "Tách nhân vật paladin canonical rồi áp dụng blur tỏa tâm với 30 mẫu và trọng số giảm dần.",
  "input_policy_vi": "Desktop và WebGPU dùng sprite sheet PNG canonical; không dùng decoder JPEG trong phép đo parity.",
  "graph": {
    "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
    "targets": [
      { "id": "chroma", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
      { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }
    ],
    "sampler": { "address_mode_u": "repeat", "address_mode_v": "repeat", "address_mode_w": "repeat", "mag_filter": "linear", "min_filter": "linear", "mipmap_filter": "linear" },
    "pipelines": {
      "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" },
      "blur": { "shader": "radial_blur.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" }
    },
    "operations": [
      {
        "id": "chroma_extract_paladin",
        "kind": "chroma_key",
        "pass": "chroma_pass",
        "pipeline": "chroma",
        "shader": "chroma_key_cropped.wgsl",
        "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }],
        "uniform": { "scale_y": 0.8, "uv_min": [0.005, 0.01], "uv_max": [0.28, 0.98], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.48, "smoothness": 0.1 },
        "vertex_count": 6,
        "instance_count": 1
      },
      {
        "id": "radial_blur_30_samples",
        "kind": "radial_blur",
        "pass": "blur_pass",
        "pipeline": "blur",
        "shader": "radial_blur.wgsl",
        "source": [{ "kind": "target", "target": "chroma" }],
        "uniform": { "center": [0.5, 0.5], "strength": 0.15, "samples": 30.0 },
        "vertex_count": 6,
        "instance_count": 1
      }
    ],
    "passes": [
      { "id": "chroma_pass", "name": "Chroma key extraction", "target": "chroma", "clear_color": [0.0, 0.0, 0.0, 0.0] },
      { "id": "blur_pass", "name": "Radial zoom blur", "target": "final", "clear_color": [0.2, 0.1, 0.3, 1.0] }
    ],
    "command_count": 2,
    "node_count": 2
  },
  "evaluation": {
    "expected_non_empty": true,
    "expected_layer_order": ["chroma_pass", "blur_pass"],
    "expected_instance_count": 2,
    "visual_check": "Nền tím tối có paladin bị kéo mờ tỏa ra từ tâm; nhân vật vẫn nhận diện được, không có ảnh đen hoặc validation error."
  }
}
