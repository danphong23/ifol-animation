{
  "test_case": "TC50",
  "title": "Exposure Inspector Overlay",
  "title_vi": "Overlay kiểm tra phơi sáng",
  "description": "Render a canonical scene and split it into zebra and false-color exposure inspection views.",
  "description_vi": "Render scene canonical rồi chia thành vùng zebra và false-color để kiểm tra phơi sáng.",
  "input_policy_vi": "Desktop và WebGPU dùng các texture PNG canonical; không dùng decoder JPEG trong phép đo parity.",
  "graph": {
    "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
    "targets": [
      { "id": "scene", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
      { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }
    ],
    "sampler": { "address_mode_u": "repeat", "address_mode_v": "repeat", "address_mode_w": "repeat", "mag_filter": "linear", "min_filter": "linear", "mipmap_filter": "linear" },
    "pipelines": {
      "background": { "shader": "texture_blit.wgsl", "blend": "AlphaBlending", "layout": "texture" },
      "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" },
      "inspector": { "shader": "exposure_inspector.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" }
