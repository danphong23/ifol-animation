    "operations": [
      { "id": "scene_background", "kind": "background", "pass": "scene_pass", "pipeline": "background", "shader": "texture_blit.wgsl", "source": [{ "kind": "asset", "asset": "canonical_bg_scifi.png" }], "vertex_count": 6, "instance_count": 1 },
      { "id": "scene_paladin", "kind": "chroma_key", "pass": "scene_pass", "pipeline": "chroma", "shader": "chroma_key_cropped.wgsl", "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }], "uniform": { "scale_y": 0.8, "uv_min": [0.005, 0.01], "uv_max": [0.28, 0.98], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.48, "smoothness": 0.1 }, "vertex_count": 6, "instance_count": 1 },
      { "id": "exposure_overlay", "kind": "exposure_inspector", "pass": "inspector_pass", "pipeline": "inspector", "shader": "exposure_inspector.wgsl", "source": [{ "kind": "target", "target": "scene" }], "uniform": { "zebra_threshold": 0.8, "zebra_speed": 2.0, "time": 1.0, "mode": 0.0 }, "vertex_count": 6, "instance_count": 1 }
