    "passes": [
      { "id": "scene_pass", "name": "Canonical scene", "target": "scene", "clear_color": [0.0, 0.0, 0.0, 1.0] },
      { "id": "inspector_pass", "name": "Zebra and false color", "target": "final", "clear_color": [0.0, 0.0, 0.0, 1.0] }
    ],
    "command_count": 3,
    "node_count": 2
  },
  "evaluation": { "expected_non_empty": true, "expected_layer_order": ["scene_pass", "inspector_pass"], "expected_instance_count": 3, "visual_check": "Nửa trái có zebra trên vùng sáng, nửa phải có false-color IRE và vạch chia trắng; không có ảnh đen hoặc validation error." }
}
