{
  "test_case": "TC08",
  "title": "Massive Draw Commands and Procedural Instances",
  "title_vi": "Một draw command với 10.000 hạt procedural",
  "description": "Render a canonical night-sky background and 10,000 procedural particle instances in one graph node.",
  "description_vi": "Render nền trời đêm canonical và 10.000 hạt procedural bằng một draw command trong cùng graph.",
  "graph": {
    "target": {
      "kind": "offscreen",
      "width": 800,
      "height": 600,
      "format": "Rgba8UnormSrgb"
