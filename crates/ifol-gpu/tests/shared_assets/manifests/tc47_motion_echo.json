{
  "test_case": "TC47",
  "title": "Motion Echo",
  "title_vi": "Tàn ảnh chuyển động",
  "description": "Extract a moving mage and composite five decaying chromatic echoes over a sci-fi background.",
  "description_vi": "Tách mage rồi tạo năm lớp tàn ảnh giảm alpha và lệch màu trên nền Sci-Fi.",
  "input_policy_vi": "Desktop và WebGPU dùng hai PNG canonical: canonical_sprites_heroes.png và canonical_bg_scifi.png.",
  "graph": { "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }, "targets": [{ "id": "mage", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }, { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }], "sampler": { "address_mode_u": "repeat", "address_mode_v": "repeat", "address_mode_w": "repeat", "mag_filter": "linear", "min_filter": "linear", "mipmap_filter": "linear" }, "pipelines": { "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending" }, "background": { "shader": "texture_blit.wgsl", "blend": "AlphaBlending" }, "echo": { "shader": "motion_echo.wgsl", "blend": "AlphaBlending" } }, "operations": [{ "id": "chroma_extract_mage", "kind": "chroma_key", "pass": "chroma_pass", "pipeline": "chroma", "shader": "chroma_key_cropped.wgsl", "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }], "uniform": { "pos": [0.15, 0.0], "scale_y": 0.75, "uv_min": [0.27, 0.01], "uv_max": [0.54, 0.98], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.48, "smoothness": 0.1 }, "instance_count": 1 }, { "id": "background", "kind": "texture_blit", "pass": "final_pass", "pipeline": "background", "shader": "texture_blit.wgsl", "source": [{ "kind": "asset", "asset": "canonical_bg_scifi.png" }], "instance_count": 1 }, { "id": "motion_echo", "kind": "motion_echo", "pass": "final_pass", "pipeline": "echo", "shader": "motion_echo.wgsl", "source": [{ "kind": "target", "target": "mage" }], "uniform": { "velocity": [-0.05, 0.0], "decay": 0.65, "hue_shift": 1.2, "num_echoes": 5.0 }, "instance_count": 1 }], "passes": [{ "id": "chroma_pass", "target": "mage", "clear_color": [0.0, 0.0, 0.0, 0.0] }, { "id": "final_pass", "target": "final", "clear_color": [0.0, 0.0, 0.0, 1.0] }], "command_count": 3, "node_count": 2 },
  "evaluation": { "expected_non_empty": true, "expected_layer_order": ["chroma_pass", "final_pass"], "expected_instance_count": 3, "visual_check": "Mage có nhiều tàn ảnh lệch trái và đổi màu trên nền Sci-Fi; không có ảnh đen hoặc validation error." }
}
