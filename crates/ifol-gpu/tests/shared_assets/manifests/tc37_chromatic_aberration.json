    "passes": [
      { "id": "chroma_pass", "name": "Chroma key extraction", "target": "chroma", "clear_color": [0.0, 0.0, 0.0, 0.0] },
      { "id": "aberration_pass", "name": "Radial RGB split", "target": "final", "clear_color": [0.1, 0.2, 0.2, 1.0] }
