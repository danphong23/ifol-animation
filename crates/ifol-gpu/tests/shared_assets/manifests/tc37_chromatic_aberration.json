  "evaluation": { "expected_non_empty": true, "expected_layer_order": ["chroma_pass", "aberration_pass"], "expected_instance_count": 2, "visual_check": "Nền xanh ngọc có paladin với viền RGB tách nhẹ theo hướng xuyên tâm; không có ảnh đen hoặc validation error." }
