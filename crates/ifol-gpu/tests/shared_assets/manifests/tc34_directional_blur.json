        "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }],
        "uniform": { "scale_y": 0.8, "uv_min": [0.27, 0.01], "uv_max": [0.54, 0.98], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.48, "smoothness": 0.1 },
        "vertex_count": 6,
        "instance_count": 1
      },
      {
        "id": "directional_blur_30deg",
        "kind": "directional_blur",
        "pass": "blur_pass",
        "pipeline": "blur",
        "shader": "directional_blur.wgsl",
        "source": [{ "kind": "target", "target": "chroma" }],
        "uniform": { "angle": 0.5235987755982988, "strength": 0.05, "samples": 20.0 },
        "vertex_count": 6,
        "instance_count": 1
      }
