{
  "test_case": "TC55",
  "title": "Dual Kawase Bloom Filter",
  "title_vi": "Bloom Dual Kawase phân cấp",
  "description": "Extract a mage, downsample through an 8-tap Kawase pass, then composite bloom and sharp foreground.",
  "description_vi": "Tách mage, giảm độ phân giải qua Kawase 8 mẫu rồi composite bloom và foreground sắc nét.",
  "input_policy_vi": "Desktop và WebGPU dùng texture PNG canonical; các target 800x600 và 400x300 dùng cùng graph contract.",
  "graph": {
    "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
    "targets": [
      { "id": "mage", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
      { "id": "downsample", "width": 400, "height": 300, "format": "Rgba8UnormSrgb" },
      { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }
    ],
    "sampler": { "address_mode_u": "clamp-to-edge", "address_mode_v": "clamp-to-edge", "address_mode_w": "clamp-to-edge", "mag_filter": "linear", "min_filter": "linear", "mipmap_filter": "linear" },
    "pipelines": {
      "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" },
      "kawase": { "shader": "dual_kawase.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" },
      "composite": { "shader": "texture_blit.wgsl", "blend": "AlphaBlending/Additive", "layout": "texture" }
    },
    "operations": [
      { "id": "kawase_extract_mage", "kind": "chroma_key", "pass": "extract_pass", "pipeline": "chroma", "shader": "chroma_key_cropped.wgsl", "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }], "uniform": { "scale_y": 0.8, "uv_min": [0.27, 0.01], "uv_max": [0.54, 0.98], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.48, "smoothness": 0.1 }, "vertex_count": 6, "instance_count": 1 },
      { "id": "kawase_downsample", "kind": "dual_kawase", "pass": "downsample_pass", "pipeline": "kawase", "shader": "dual_kawase.wgsl", "source": [{ "kind": "target", "target": "mage" }], "uniform": { "offset": 4.5, "intensity": 2.2 }, "vertex_count": 6, "instance_count": 1 },
      { "id": "kawase_background", "kind": "background", "pass": "composite_pass", "pipeline": "composite", "shader": "texture_blit.wgsl", "source": [{ "kind": "asset", "asset": "canonical_bg_scifi.png" }], "vertex_count": 6, "instance_count": 1 },
      { "id": "kawase_bloom", "kind": "additive_bloom", "pass": "composite_pass", "pipeline": "composite", "shader": "texture_blit.wgsl", "source": [{ "kind": "target", "target": "downsample" }], "vertex_count": 6, "instance_count": 1 },
      { "id": "kawase_foreground", "kind": "sharp_foreground", "pass": "composite_pass", "pipeline": "composite", "shader": "texture_blit.wgsl", "source": [{ "kind": "target", "target": "mage" }], "vertex_count": 6, "instance_count": 1 }
    ],
    "passes": [
      { "id": "extract_pass", "name": "Mage extraction", "target": "mage", "clear_color": [0.0, 0.0, 0.0, 0.0] },
      { "id": "downsample_pass", "name": "400x300 Kawase downsample", "target": "downsample", "clear_color": [0.0, 0.0, 0.0, 0.0] },
      { "id": "composite_pass", "name": "Background, bloom and sharp mage", "target": "final", "clear_color": [0.05, 0.05, 0.1, 1.0] }
    ],
    "command_count": 5,
    "node_count": 3
  },
  "evaluation": { "expected_non_empty": true, "expected_layer_order": ["extract_pass", "downsample_pass", "composite_pass"], "expected_instance_count": 5, "visual_check": "Nền Sci-Fi có mage sắc nét cùng glow bloom mềm; không bị mất foreground hoặc sai tỷ lệ sau downsample." }
}
