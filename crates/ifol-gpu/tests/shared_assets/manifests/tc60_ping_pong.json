{
  "test_case": "TC60",
  "title": "Ping-Pong Feedback Loop",
  "title_vi": "Vòng phản hồi ping-pong",
  "description": "Render a wizard and accumulate deterministic zoom feedback through alternating ping and pong targets.",
  "description_vi": "Render wizard rồi tích lũy phản hồi zoom xác định qua hai target ping và pong luân phiên.",
  "input_policy_vi": "Desktop và WebGPU dùng cùng sprite PNG canonical, cùng target 800x600 và cùng sequence 16 bước feedback.",
  "graph": {
    "target": { "kind": "offscreen", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
    "targets": [
      { "id": "ping", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
      { "id": "pong", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" },
      { "id": "final", "width": 800, "height": 600, "format": "Rgba8UnormSrgb" }
    ],
    "sampler": { "address_mode_u": "clamp-to-edge", "address_mode_v": "clamp-to-edge", "address_mode_w": "clamp-to-edge", "mag_filter": "linear", "min_filter": "linear", "mipmap_filter": "linear" },
    "pipelines": {
      "chroma": { "shader": "chroma_key_cropped.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" },
      "feedback": { "shader": "ping_pong_blit.wgsl", "blend": "AlphaBlending", "layout": "texture_uniform" }
    },
    "operations": [
      { "id": "feedback_seed", "kind": "chroma_key", "pass": "seed_pass", "pipeline": "chroma", "shader": "chroma_key_cropped.wgsl", "source": [{ "kind": "asset", "asset": "canonical_sprites_heroes.png" }], "uniform": { "pos": [0.0, 0.0], "scale_y": 0.65, "uv_min": [0.30, 0.0], "uv_max": [0.52, 1.0], "key_color": [0.0, 1.0, 0.0], "tolerance": 0.45, "smoothness": 0.12 }, "vertex_count": 6, "instance_count": 1 },
      { "id": "feedback_zoom_out", "kind": "feedback", "pass": "feedback_passes", "pipeline": "feedback", "shader": "ping_pong_blit.wgsl", "source": [{ "kind": "target", "target": "ping" }], "uniform": { "pos": [0.008, 0.008], "scale": [1.025, 1.025], "opacity": 0.85 }, "vertex_count": 6, "instance_count": 8 },
      { "id": "feedback_zoom_in", "kind": "feedback", "pass": "feedback_passes", "pipeline": "feedback", "shader": "ping_pong_blit.wgsl", "source": [{ "kind": "target", "target": "pong" }], "uniform": { "pos": [-0.005, -0.005], "scale": [1.025, 1.025], "opacity": 0.85 }, "vertex_count": 6, "instance_count": 8 },
      { "id": "feedback_final_copy", "kind": "copy", "pass": "final_pass", "pipeline": "feedback", "shader": "ping_pong_blit.wgsl", "source": [{ "kind": "target", "target": "ping" }], "uniform": { "pos": [0.0, 0.0], "scale": [1.0, 1.0], "opacity": 1.0 }, "vertex_count": 6, "instance_count": 1 }
    ],
    "passes": [
      { "id": "seed_pass", "name": "Wizard seed", "target": "ping", "clear_color": [0.05, 0.05, 0.08, 1.0] },
      { "id": "feedback_passes", "name": "8 ping-pong cycles", "target": "ping/pong", "clear_color": [0.0, 0.0, 0.0, 0.0] },
      { "id": "final_pass", "name": "Final copy", "target": "final", "clear_color": [0.02, 0.02, 0.04, 1.0] }
    ],
    "command_count": 20,
    "node_count": 3
  },
  "evaluation": { "expected_non_empty": true, "expected_layer_order": ["seed_pass", "feedback_passes", "final_pass"], "expected_instance_count": 18, "visual_check": "Wizard trung tâm có chuỗi echo đồng tâm, opacity giảm dần, không đen và không vỡ alpha." }
}
